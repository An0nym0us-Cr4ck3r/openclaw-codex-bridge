#!/usr/bin/env python3
"""Thin UDS client — no WS. Submits to codex-bridge-daemon and prints reply."""
from __future__ import annotations

import json
import os
import socket
import sys
from pathlib import Path

DEFAULT_UDS = "/run/user/1000/codex-bridge.sock"


def main() -> int:
    uds = os.environ.get("CODEX_BRIDGE_SOCK", DEFAULT_UDS)
    text = " ".join(sys.argv[1:]).strip() if len(sys.argv) > 1 else sys.stdin.read().strip()
    if not text:
        print("usage: miku-to-codex MESSAGE", file=sys.stderr)
        return 2
    sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    sock.settimeout(1800)
    try:
        sock.connect(uds)
    except (FileNotFoundError, ConnectionRefusedError, OSError) as e:
        print(f"codex-bridge.sock not found — is daemon running? ({e})", file=sys.stderr)
        return 3
    req = {"id": 1, "method": "submit", "params": {"text": text, "source": "miku"}}
    sock.sendall((json.dumps(req, ensure_ascii=False) + "\n").encode())
    # read one JSON line
    buf = b""
    sock.settimeout(1800)
    while b"\n" not in buf:
        chunk = sock.recv(4096)
        if not chunk:
            break
        buf += chunk
    if not buf:
        print("no reply from daemon", file=sys.stderr)
        return 1
    line = buf.split(b"\n", 1)[0].decode("utf-8", errors="replace")
    try:
        resp = json.loads(line)
    except json.JSONDecodeError:
        print(line)
        return 0
    if "error" in resp:
        print(f"daemon error: {resp['error']}", file=sys.stderr)
        return 1
    result = resp.get("result") or {}
    reply = result.get("reply") or ""
    # stdout is the Codex reply (caller uses it). Fanout is daemon-owned.
    if reply:
        print(reply)
    else:
        # empty reply is not an error (e.g., tool-only turn)
        pass
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
