#!/usr/bin/env bash
# codex-tg-send — Codex→Telegram CC シンク（最小権限・宛先固定）
TARGET="7536160870"
CHANNEL="telegram"
ACCOUNT="default"
PREFIX="[Codex]"
OPENCLAW_BIN="/home/s0u7a/.local/bin/openclaw"

if [ $# -lt 1 ] || [ -z "$1" ]; then
  echo "ERROR: usage: $0 \"<message>\"" >&2
  exit 2
fi
MSG="$1"

case "$MSG" in
  "$PREFIX"*) : ;;
  *) MSG="$PREFIX $MSG" ;;
esac

if [ ${#MSG} -gt 4000 ]; then
  echo "ERROR: message too large (${#MSG} chars, limit 4000)" >&2
  exit 3
fi
if printf '%s' "$MSG" | grep -qiE 'sk-[A-Za-z0-9]|api[_-]?key|password|secret|token[=:]|BEGIN (RSA|OPENSSH|EC) PRIVATE'; then
  echo "ERROR: refusing to send message that may contain a secret (keyword guard)" >&2
  exit 4
fi

if [ -n "$CODEX_TG_DRYRUN" ] && [ "$CODEX_TG_DRYRUN" = "1" ]; then
  "$OPENCLAW_BIN" message send --channel "$CHANNEL" --account "$ACCOUNT" --target "$TARGET" --message "$MSG" --dry-run
else
  "$OPENCLAW_BIN" message send --channel "$CHANNEL" --account "$ACCOUNT" --target "$TARGET" --message "$MSG"
fi
